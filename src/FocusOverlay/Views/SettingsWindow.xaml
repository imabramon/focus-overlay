<Window x:Class="FocusOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:FocusOverlay.Properties"
        xmlns:local="clr-namespace:FocusOverlay.Views"
        Title="{x:Static p:Strings.WindowTitleSettings}"
        Width="500"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        Icon="/Assets/eye.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Field" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="CornerButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="GroupName" Value="Corner" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.CommonClose}" IsCancel="True" Click="OnCloseClick" />
            <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static p:Strings.CommonImport}" Margin="0" Click="OnImportClick" ToolTip="{x:Static p:Strings.SettingsImportTooltip}" />
                <Button Content="{x:Static p:Strings.CommonExport}" Click="OnExportClick" ToolTip="{x:Static p:Strings.SettingsExportTooltip}" />
                <Button Content="{x:Static p:Strings.SettingsReset}" Click="OnResetClick" />
            </StackPanel>
        </DockPanel>

        <GroupBox DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="8,6" Header="{x:Static p:Strings.SettingsBackupGroup}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static p:Strings.SettingsExportAll}" Margin="0" Click="OnExportAllClick" />
                <Button Content="{x:Static p:Strings.CommonImportAll}" Click="OnImportAllClick" />
            </StackPanel>
        </GroupBox>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{x:Static p:Strings.SettingsLanguage}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="LanguageCombo" Width="180" HorizontalAlignment="Left"
                      DisplayMemberPath="Label" SelectedValuePath="Value" />
        </DockPanel>

        <TabControl>
            <TabItem Header="{x:Static p:Strings.SettingsTabOverlay}">
                <StackPanel x:Name="LayoutGroup" Margin="10">
                    <TextBlock Text="{x:Static p:Strings.SettingsScreenCorner}" Margin="0,0,0,4" />
                    <Border HorizontalAlignment="Left" Width="220" Height="130" Margin="0,0,0,10"
                            BorderBrush="Gray" BorderThickness="2" CornerRadius="4" Background="#FF2B2B2B">
                        <Grid>
                            <RadioButton x:Name="CornerTopLeft" Style="{StaticResource CornerButton}" Content="↖"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Checked="OnCornerChecked" />
                            <RadioButton x:Name="CornerTopRight" Style="{StaticResource CornerButton}" Content="↗"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Checked="OnCornerChecked" />
                            <RadioButton x:Name="CornerTopCenter" Style="{StaticResource CornerButton}" Content="↑"
                                         HorizontalAlignment="Center" VerticalAlignment="Top" Checked="OnCornerChecked" />
                            <RadioButton x:Name="CornerBottomCenter" Style="{StaticResource CornerButton}" Content="↓"
                                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Checked="OnCornerChecked" />
                            <RadioButton x:Name="CornerBottomLeft" Style="{StaticResource CornerButton}" Content="↙"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Checked="OnCornerChecked" />
                            <RadioButton x:Name="CornerBottomRight" Style="{StaticResource CornerButton}" Content="↘"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Checked="OnCornerChecked" />
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{x:Static p:Strings.SettingsOffsetX}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}"
                                 Text="{Binding OffsetX, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Text="{x:Static p:Strings.SettingsOffsetY}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}"
                                 Text="{Binding OffsetY, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Text="{x:Static p:Strings.SettingsWidth}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}"
                                 Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Text="{x:Static p:Strings.SettingsHeight}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}"
                                 Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Text="{x:Static p:Strings.SettingsZoom}" Style="{StaticResource FieldLabel}" />
                        <DockPanel Grid.Row="4" Grid.Column="1" Style="{StaticResource Field}">
                            <TextBlock DockPanel.Dock="Right" Width="36" TextAlignment="Right"
                                       Text="{Binding Scale, StringFormat={}{0:0.00}}" />
                            <Slider Minimum="0.5" Maximum="3" SmallChange="0.05" LargeChange="0.1"
                                    IsSnapToTickEnabled="True" TickFrequency="0.05"
                                    Value="{Binding Scale}" />
                        </DockPanel>

                        <TextBlock Grid.Row="5" Text="{x:Static p:Strings.SettingsFontSize}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource Field}"
                                 Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="6" Text="{x:Static p:Strings.SettingsBackgroundOpacity}" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Row="6" Grid.Column="1" Style="{StaticResource Field}"
                                Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding BackgroundOpacity}" />

                        <TextBlock Grid.Row="7" Text="{x:Static p:Strings.SettingsTextColor}" Style="{StaticResource FieldLabel}" />
                        <local:ColorPickerBox Grid.Row="7" Grid.Column="1" Style="{StaticResource Field}"
                                              ColorText="{Binding TextColor}" ColorChanged="OnColorChanged" />

                        <TextBlock Grid.Row="8" Text="{x:Static p:Strings.SettingsAccentColor}" Style="{StaticResource FieldLabel}" />
                        <local:ColorPickerBox Grid.Row="8" Grid.Column="1" Style="{StaticResource Field}"
                                              ColorText="{Binding AccentColor}" ColorChanged="OnColorChanged" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static p:Strings.SettingsTabTabStrip}">
                <StackPanel x:Name="StripGroup" Margin="10">
                    <CheckBox Content="{x:Static p:Strings.SettingsTabStripVisible}" IsChecked="{Binding Visible}" Margin="0,0,0,6" />
                    <CheckBox Content="{x:Static p:Strings.SettingsTabStripDetached}" IsChecked="{Binding Detached}" />
                    <TextBlock Margin="20,2,0,0" Foreground="Gray" TextWrapping="Wrap" FontSize="11"
                               Text="{x:Static p:Strings.SettingsTabStripAttachedHint}" />

                    <TextBlock Text="{x:Static p:Strings.SettingsPosition}" Style="{StaticResource SectionTitle}" />
                    <Grid IsEnabled="{Binding Detached}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{x:Static p:Strings.SettingsScreenCorner}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="StripCornerCombo" Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Corner}" />

                        <TextBlock Grid.Row="1" Text="{x:Static p:Strings.SettingsOffsetX}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}"
                                 Text="{Binding OffsetX, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Text="{x:Static p:Strings.SettingsOffsetY}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}"
                                 Text="{Binding OffsetY, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Text="{x:Static p:Strings.SettingsWidth}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}"
                                 Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="{x:Static p:Strings.SettingsAppearance}" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{x:Static p:Strings.SettingsTabStripZoom}" Style="{StaticResource FieldLabel}"
                                   ToolTip="{x:Static p:Strings.SettingsTabStripZoomTooltip}" />
                        <DockPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}">
                            <TextBlock DockPanel.Dock="Right" Width="36" TextAlignment="Right"
                                       Text="{Binding Scale, StringFormat={}{0:0.00}}" />
                            <Slider Minimum="0.5" Maximum="2" SmallChange="0.05" LargeChange="0.1"
                                    IsSnapToTickEnabled="True" TickFrequency="0.05"
                                    Value="{Binding Scale}" />
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="{x:Static p:Strings.SettingsFontSize}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}"
                                 Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Text="{x:Static p:Strings.SettingsBackgroundOpacity}" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}"
                                Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding BackgroundOpacity}" />

                        <TextBlock Grid.Row="3" Text="{x:Static p:Strings.SettingsTextColor}" Style="{StaticResource FieldLabel}" />
                        <local:ColorPickerBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}"
                                              ColorText="{Binding TextColor}" ColorChanged="OnColorChanged" />

                        <TextBlock Grid.Row="4" Text="{x:Static p:Strings.SettingsActiveTabColor}" Style="{StaticResource FieldLabel}" />
                        <local:ColorPickerBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Field}"
                                              ColorText="{Binding AccentColor}" ColorChanged="OnColorChanged" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static p:Strings.SettingsTabHotkeys}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <Grid x:Name="HotkeysGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <TextBlock Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="{x:Static p:Strings.SettingsHotkeysHint}" />
                    <TextBlock x:Name="HotkeyStatus" Margin="0,6,0,0" Foreground="Firebrick" TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
