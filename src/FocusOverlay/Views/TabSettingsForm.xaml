<UserControl x:Class="FocusOverlay.Views.TabSettingsForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:FocusOverlay.Properties"
             xmlns:local="clr-namespace:FocusOverlay.Views">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Field" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,3,16,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ClearButton" TargetType="Button">
            <Setter Property="Content" Value="×" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ToolTip" Value="{x:Static p:Strings.EditorClearValue}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static p:Strings.SettingsScreenCorner}" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="CornerCombo" Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}"
                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnFieldChanged" />

        <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static p:Strings.SettingsZoom}" Style="{StaticResource FieldLabel}"
                   ToolTip="{x:Static p:Strings.EditorScaleTooltip}" />
        <TextBox x:Name="ScaleBox" Grid.Row="0" Grid.Column="3" Style="{StaticResource Field}" TextChanged="OnFieldChanged" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static p:Strings.SettingsOffsetX}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="OffsetXBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" TextChanged="OnFieldChanged" />

        <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static p:Strings.SettingsOffsetY}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="OffsetYBox" Grid.Row="1" Grid.Column="3" Style="{StaticResource Field}" TextChanged="OnFieldChanged" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static p:Strings.SettingsWidth}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="WidthBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" TextChanged="OnFieldChanged" />

        <TextBlock Grid.Row="2" Grid.Column="2" Text="{x:Static p:Strings.SettingsHeight}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="HeightBox" Grid.Row="2" Grid.Column="3" Style="{StaticResource Field}" TextChanged="OnFieldChanged" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static p:Strings.SettingsFontSize}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="FontSizeBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}" TextChanged="OnFieldChanged" />

        <TextBlock Grid.Row="3" Grid.Column="2" Text="{x:Static p:Strings.SettingsBackgroundOpacity}" Style="{StaticResource FieldLabel}"
                   ToolTip="{x:Static p:Strings.EditorOpacityTooltip}" />
        <TextBox x:Name="OpacityBox" Grid.Row="3" Grid.Column="3" Style="{StaticResource Field}" TextChanged="OnFieldChanged" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static p:Strings.SettingsTextColor}" Style="{StaticResource FieldLabel}" />
        <DockPanel Grid.Row="4" Grid.Column="1" Style="{StaticResource Field}">
            <Button DockPanel.Dock="Right" Style="{StaticResource ClearButton}" Click="OnClearTextColorClick" />
            <local:ColorPickerBox x:Name="TextColorBox" ColorChanged="OnFieldChanged" />
        </DockPanel>

        <TextBlock Grid.Row="4" Grid.Column="2" Text="{x:Static p:Strings.SettingsAccentColor}" Style="{StaticResource FieldLabel}" />
        <DockPanel Grid.Row="4" Grid.Column="3" Style="{StaticResource Field}">
            <Button DockPanel.Dock="Right" Style="{StaticResource ClearButton}" Click="OnClearAccentColorClick" />
            <local:ColorPickerBox x:Name="AccentColorBox" ColorChanged="OnFieldChanged" />
        </DockPanel>
    </Grid>
</UserControl>
