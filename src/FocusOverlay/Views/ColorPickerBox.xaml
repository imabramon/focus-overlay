<UserControl x:Class="FocusOverlay.Views.ColorPickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:FocusOverlay.Properties">
    <UserControl.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White" Geometry="M0,0 H2 V2 H0Z" />
                    <GeometryDrawing Brush="#FFCCCCCC" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FF808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{StaticResource CheckerBrush}" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <ToggleButton x:Name="SwatchButton" DockPanel.Dock="Left" Width="40" Margin="0,0,6,0" Padding="2"
                      Cursor="Hand" ToolTip="{x:Static p:Strings.ColorPickerTooltip}">
            <Border Style="{StaticResource Swatch}" Width="30" Height="16">
                <Border x:Name="SwatchFill" CornerRadius="2" />
            </Border>
        </ToggleButton>
        <TextBox x:Name="HexBox" VerticalContentAlignment="Center" FontFamily="Consolas" TextChanged="OnHexTextChanged" />

        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=SwatchButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=SwatchButton, Mode=TwoWay}">
            <Border Margin="0,4,8,8" Padding="10" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" />
                </Border.Effect>
                <StackPanel Width="240">
                    <Grid x:Name="SvArea" Height="150" Cursor="Cross" ClipToBounds="True"
                          MouseLeftButtonDown="OnSvMouseDown" MouseMove="OnSvMouseMove" MouseLeftButtonUp="OnAreaMouseUp"
                          SizeChanged="OnAreaSizeChanged">
                        <Rectangle x:Name="HueFill" Fill="Red" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="Black" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SvThumb" Width="12" Height="12" Stroke="White" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.9" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>

                    <Grid x:Name="HueArea" Height="14" Margin="0,8,0,0" Cursor="Hand"
                          MouseLeftButtonDown="OnHueMouseDown" MouseMove="OnHueMouseMove" MouseLeftButtonUp="OnAreaMouseUp"
                          SizeChanged="OnAreaSizeChanged">
                        <Rectangle RadiusX="3" RadiusY="3">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFF0000" Offset="0" />
                                    <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                    <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                    <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                    <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                    <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                    <GradientStop Color="#FFFF0000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="HueThumb" Width="6" Height="18" Canvas.Top="-2" CornerRadius="2"
                                    BorderBrush="White" BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.9" />
                                </Border.Effect>
                            </Border>
                        </Canvas>
                    </Grid>

                    <WrapPanel x:Name="Palette" Margin="0,8,0,0" />

                    <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="4" Background="#E6181512">
                        <StackPanel>
                            <TextBlock x:Name="PreviewHeading" Text="{x:Static p:Strings.ColorPickerPreviewHeading}" FontSize="16" FontWeight="Bold" />
                            <TextBlock x:Name="PreviewText" Text="{x:Static p:Strings.ColorPickerPreviewText}" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="{x:Static p:Strings.ColorPickerBefore}" Foreground="Gray" FontSize="11" />
                            <Border Style="{StaticResource Swatch}" Height="20">
                                <Border x:Name="OldSwatch" CornerRadius="2" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="{x:Static p:Strings.ColorPickerAfter}" Foreground="Gray" FontSize="11" />
                            <Border Style="{StaticResource Swatch}" Height="20">
                                <Border x:Name="NewSwatch" CornerRadius="2" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.CommonCancel}" Padding="10,2" Margin="6,0,0,0" Click="OnCancelClick" />
                        <Button DockPanel.Dock="Right" Content="OK" Padding="14,2" Margin="6,0,0,0" IsDefault="True" Click="OnOkClick" />
                        <TextBox x:Name="PopupHexBox" VerticalContentAlignment="Center" FontFamily="Consolas"
                                 TextChanged="OnHexTextChanged" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </DockPanel>
</UserControl>
