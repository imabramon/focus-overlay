<local:ClickThroughWindow x:Class="FocusOverlay.Views.TabStripWindow"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:p="clr-namespace:FocusOverlay.Properties"
                         xmlns:local="clr-namespace:FocusOverlay.Views"
                         Title="{x:Static p:Strings.WindowTitleTabStrip}"
                         Width="420"
                         Height="40">
    <Grid x:Name="RootGrid" VerticalAlignment="Top">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Border x:Name="StripBorder" CornerRadius="8" Padding="10,6,10,2">
            <DockPanel>
                <TextBlock x:Name="PageCounter" DockPanel.Dock="Right" Margin="8,2,0,4" VerticalAlignment="Top" />
                <WrapPanel x:Name="TabStrip" />
            </DockPanel>
        </Border>
    </Grid>
</local:ClickThroughWindow>
