<local:ClickThroughWindow x:Class="FocusOverlay.Views.OverlayWindow"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="clr-namespace:FocusOverlay.Views"
                         Title="Focus Overlay"
                         Width="420"
                         Height="560">
    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Border x:Name="FrameBorder" CornerRadius="8" Padding="12,10">
            <FlowDocumentScrollViewer x:Name="DocumentViewer"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsToolBarVisible="False"
                                      IsSelectionEnabled="False"
                                      Focusable="False">
                <FlowDocumentScrollViewer.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.9" />
                </FlowDocumentScrollViewer.Effect>
            </FlowDocumentScrollViewer>
        </Border>
    </Grid>
</local:ClickThroughWindow>
