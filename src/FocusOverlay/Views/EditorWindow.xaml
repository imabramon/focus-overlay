<Window x:Class="FocusOverlay.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:FocusOverlay.Properties"
        xmlns:local="clr-namespace:FocusOverlay.Views"
        Title="{x:Static p:Strings.WindowTitleEditor}"
        Width="1080"
        Height="740"
        MinWidth="820"
        MinHeight="520"
        Icon="/Assets/eye.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="StatusButton" TargetType="ButtonBase">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static p:Strings.EditorNew}" Click="OnNewPresetClick" />
                <Button Content="{x:Static p:Strings.EditorDelete}" Click="OnDeletePresetClick" />
                <Button x:Name="ImportButton" Content="{x:Static p:Strings.EditorImportMenu}" Click="OnImportClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static p:Strings.EditorImportArchive}" Click="OnImportArchiveClick" />
                            <MenuItem Header="{x:Static p:Strings.EditorImportFolder}" Click="OnImportFolderClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="{x:Static p:Strings.CommonExport}" Click="OnExportClick" />
                <Button Content="{x:Static p:Strings.EditorData}" ToolTip="{x:Static p:Strings.EditorDataTooltip}" Click="OnDataClick" />
                <Button Content="{x:Static p:Strings.CommonSettings}" Margin="16,0,0,0" Click="OnSettingsClick" />
            </StackPanel>
            <TextBlock Text="{x:Static p:Strings.EditorPresetLabel}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="PresetCombo" Width="220" DisplayMemberPath="Name" SelectionChanged="OnPresetSelectionChanged" />
            <TextBlock Text="{x:Static p:Strings.EditorNameLabel}" Style="{StaticResource FieldLabel}" Margin="16,0,8,0" />
            <TextBox VerticalContentAlignment="Center"
                     Text="{Binding SelectedItem.Name, ElementName=PresetCombo, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <ToggleButton x:Name="IssuesButton" Style="{StaticResource StatusButton}"
                          ToolTip="{x:Static p:Strings.EditorIssuesTooltip}"
                          Checked="OnIssuesToggled" Unchecked="OnIssuesToggled">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock x:Name="IssueCount" Text="0" Margin="4,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <Button Style="{StaticResource StatusButton}" ToolTip="{x:Static p:Strings.EditorMarkupHelp}" Click="OnHelpClick">
                <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1.5"
                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                    <TextBlock Text="?" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Button>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="IssuesColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <ToggleButton x:Name="SystemToggle" DockPanel.Dock="Top" Margin="0,0,0,6" Padding="10,3"
                              Content="{x:Static p:Strings.EditorSystemTab}"
                              ToolTip="{x:Static p:Strings.EditorSystemTabTooltip}"
                              Checked="OnSystemToggled" Unchecked="OnSystemToggled" />
                <UniformGrid DockPanel.Dock="Bottom" Columns="4" Margin="0,6,0,0">
                    <Button Content="+" ToolTip="{x:Static p:Strings.EditorAddPage}" Margin="0" Click="OnAddPageClick" />
                    <Button Content="−" ToolTip="{x:Static p:Strings.EditorRemovePage}" Margin="4,0,0,0" Click="OnRemovePageClick" />
                    <Button Content="↑" ToolTip="{x:Static p:Strings.EditorMoveUp}" Margin="4,0,0,0" Click="OnMovePageUpClick" />
                    <Button Content="↓" ToolTip="{x:Static p:Strings.EditorMoveDown}" Margin="4,0,0,0" Click="OnMovePageDownClick" />
                </UniformGrid>
                <ListBox x:Name="PageList" DisplayMemberPath="Title" SelectionChanged="OnPageSelectionChanged" />
            </DockPanel>

            <Grid Grid.Column="2">
                <DockPanel x:Name="PageEditor"
                           DataContext="{Binding SelectedItem, ElementName=PageList}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.EditorInsertImage}" Click="OnInsertImageClick" />
                        <TextBlock Text="{x:Static p:Strings.EditorTitleLabel}" Style="{StaticResource FieldLabel}" />
                        <TextBox VerticalContentAlignment="Center"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <Expander x:Name="PageSettingsExpander" DockPanel.Dock="Top" Margin="0,0,0,6"
                              Header="{x:Static p:Strings.EditorPageSettings}">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Margin="0,0,0,4" Foreground="Gray" TextWrapping="Wrap"
                                       Text="{x:Static p:Strings.EditorPageSettingsHint}" />
                            <local:TabSettingsForm x:Name="PageSettingsForm" Changed="OnPageSettingsChanged" />
                        </StackPanel>
                    </Expander>
                    <TextBox x:Name="ContentBox"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="13"
                             TextChanged="OnContentTextChanged" />
                </DockPanel>
                <DockPanel x:Name="SystemEditor" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="{x:Static p:Strings.EditorSystemHint}" />
                    <local:TabSettingsForm x:Name="SystemSettingsForm" VerticalAlignment="Top" Changed="OnSystemSettingsChanged" />
                </DockPanel>
            </Grid>

            <DockPanel x:Name="IssuesPanel" Grid.Column="3" Margin="10,0,0,0" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource StatusButton}" Content="×"
                            ToolTip="{x:Static p:Strings.CommonClose}" Click="OnIssuesCloseClick" />
                    <TextBlock Text="{x:Static p:Strings.EditorIssuesTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="NoIssuesText" DockPanel.Dock="Top" Foreground="Gray"
                           Text="{x:Static p:Strings.EditorNoIssues}" />
                <ListBox x:Name="IssueList" Foreground="#B00020"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="OnIssueClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,3" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
